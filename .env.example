# Razorpay — used only by the serverless functions in /api.
# Get test-mode keys from https://dashboard.razorpay.com/app/keys (toggle "Test Mode" on).
# Copy this file to .env.local for local `vercel dev`, and add the same two
# values in Vercel → Project → Settings → Environment Variables for deploys.
# Never commit real keys, and never expose RAZORPAY_KEY_SECRET to the frontend.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# TBO static-IP relay (AWS Lightsail gateway). Live TBO only accepts calls from a whitelisted IP and
# Vercel's IPs change, so route every TBO call through the gateway: it forwards from 13.202.13.171.
# Leave both empty to call TBO directly (fine on staging, not allowed on live).
# TBO_RELAY_URL=https://api.protoursandtravelsolutions.com/tbo
# TBO_RELAY_TOKEN=<the gateway's INTERNAL_API_TOKEN: server only, never VITE_>
# With the relay the TBO hosts are set on the gateway (/etc/tbo-api.env), so TBO_LIVE_*_URL are not used.
# Live: also set TBO_END_USER_IP=13.202.13.171 (the whitelisted public IP, sent as EndUserIp).
